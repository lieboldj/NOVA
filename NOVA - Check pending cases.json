        "jsCode": "const j = $input.first().json;\nconst b = j.body || {};\nreturn [{ json: {\n  status: \"ok\",\n  drafted: b.drafted != null ? b.drafted : null,\n  closed: b.closed != null ? b.closed : null,\n  escalated: b.escalated != null ? b.escalated : null,\n  skipped: b.skipped != null ? b.skipped : null,\n  raw: b,\n} }];"
