      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -736,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: {\n  base_url: j.base_url,\n  max_attempts: j.max_attempts != null ? j.max_attempts : 3,\n  attempt: (j.attempt != null ? j.attempt : 0) + 1,\n} }];"
      },
      "id": "e6d8f96c-35a8-4a78-b524-91f9b543c6b1",
      "name": "Increment attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url }}/automation/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a1b9ee66-631e-46dd-ab58-c9bf164a4eb8",
      "name": "Call NOVA /automation/tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -16,
        176
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst status = (item && item.statusCode != null) ? item.statusCode : 0;\nconst cfg = $(\"Increment attempt\").first().json;\nconst attempt = cfg.attempt;\nconst max = cfg.max_attempts != null ? cfg.max_attempts : 3;\nconst body = item ? item.body : undefined;\nlet decision;\nif (status >= 200 && status < 300) decision = \"success\";\nelse if (status === 401 || status === 403) decision = \"credential\";\nelse if (status === 429 || status >= 500 || status === 0) decision = (attempt < max) ? \"retry\" : \"exhausted\";\nelse if (status >= 400) decision = \"client_error\";\nelse decision = (attempt < max) ? \"retry\" : \"exhausted\";\nreturn [{ json: { decision, status, attempt, max_attempts: max, base_url: cfg.base_url, body } }];"
      },
      "id": "29031c72-4914-45f9-9fe7-b040c565e27d",
