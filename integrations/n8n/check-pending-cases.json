{
  "name": "NOVA - Check pending cases",
  "nodes": [
    {
      "id": "nova-schedule",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 15}]}}
    },
    {
      "id": "nova-check",
      "name": "Ask NOVA to check pending work",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 0],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/automation/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {"timeout": 30000}
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {"main": [[{"node": "Ask NOVA to check pending work", "type": "main", "index": 0}]]}
  },
  "settings": {"timezone": "Europe/Berlin", "executionOrder": "v1"},
  "active": false
}
