# Copy settings into your local .env as needed. Never commit credentials.
DATABASE_URL=sqlite:///./.data/nova.db
STORAGE_PATH=.data/documents
# Set for private Google Cloud Storage; leave empty for local filesystem storage.
STORAGE_BUCKET=
NOVA_REVIEWER_TOKEN=
NOVA_AUTOMATION_TOKEN=
NOVA_REVIEWER_NAME=local-reviewer
AI_MODE=gemini
ANONYMIZER_MODE=anymize
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANYMIZE_API_KEY=
ANYMIZE_BASE_URL=https://app.anymize.ai/api
MAIL_MODE=simulation
RESPONSE_DAYS=7
MAX_REMINDERS=2
# Initial requests always need reviewer approval. Automatic follow-ups/reminders wait before sending.
# Accept supported, unambiguous supplier answers above 90% after validation.
AUTO_ACCEPT_HIGH_CONFIDENCE=true
AUTO_SEND_FOLLOWUPS=true
AUTO_SEND_DELAY_MINUTES=2
# Also react to missing/invalid answers while received data awaits human review.
AUTO_FOLLOWUP_ENABLED=false
AUTO_FOLLOWUP_MAX_ROUNDS=3
# For isolated offline fixtures ONLY, set both AI_MODE=fixture and ANONYMIZER_MODE=fixture.
# SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_SENDER, SMTP_STARTTLS
# are used only when MAIL_MODE=smtp. Initial requests still require reviewer approval.

# Two-account Gmail test setup. Set MAIL_MODE=gmail to send approved drafts through Gmail.
GMAIL_MAILBOX=devstar4415@gcplab.me
GMAIL_SUPPLIER=devstar4418@gcplab.me
# Run uv run python scripts/connect_gmail.py to obtain local credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Browser review sessions. Enable secure cookies when serving over HTTPS.
NOVA_COOKIE_SECURE=false
FRONTEND_DIST=dist
